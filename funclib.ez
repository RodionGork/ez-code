def flib = {
    'pl': {
        'callname': 'sub callname{(\&{$_[0]})->(@{$_[1]});}',
        'eq': ['sub streq{$_[0] eq $_[1];}', 'streq'],
        'halt': 'sub halt{say($_[1]);exit($_[0]);}',
        'haskey': 'sub haskey{defined $_[1]->{$_[0]};}',
        'isarray': 'sub isarray{ref($_[0]) eq "ARRAY";}',
        'join': ['sub ajoin{join $_[0], @{$_[1]}}', 'ajoin'],
        'keys': ['sub hkeys{my @res = keys(%{$_[0]}); \@res;}', 'hkeys'],
        'len': 'sub len{scalar @{$_[0]};}',
        'match': 'sub match{$_[0] =~ qr/$_[1]/;}',
        'pop': ['sub apop{pop @{$_[0]};}', 'apop'],
        'push': ['sub apush{push @{$_[0]}, $_[1];}', 'apush'],
        'scmp': 'sub scmp{$_[0] cmp $_[1];}',
        'slice': 'sub slice{my @res = @{$_[0]}[$_[1] .. $_[2]];\@res;}',
        'shift': ['sub ashift{shift @{$_[0]};}', 'ashift'],
        'sort': ['sub asort{my @res = sort @{$_[0]};\@res;}', 'asort'],
        'split': ['sub asplit{my @res = split($_[0],$_[1],($_[2]//0)); \@res;}', 'asplit'],
        'subst': 'sub subst{$_[0] =~ s/$_[1]/$_[2]/rg;}',
        'unshift': ['sub aunshift{unshift @{$_[0]}, $_[1];}', 'aunshift'],
        'writeln': 'sub writeln{say(@_);}'
    },
    'js': {
        'atan2': 'function atan2(a,b){return Math.atan2(a,b)}',
        'eq': 'function eq(a,b){return a == b}',
        'halt': 'function halt(code,msg){throw new Error(msg))}',
        'haskey': 'function haskey(k,o){return Object.hasOwn(o,k)}',
        'int': 'function int(x){return Math.floor(x)}',
        'isarray': 'function isarray(a){return Array.isArray(a)}',
        'join': 'function join(sep,a){return a.join(sep)}',
        'keys': ['', 'Object.keys'],
        'len': 'function len(a){return a.length}',
        'match': 'function match(s,r){return s.match(new RegExp(r))!==null}',
        'pop': 'function pop(a){return a.pop()}',
        'push': 'function push(a,x){a.push(x)}',
        'scmp': 'function scmp(a,b){return a.localeCompare(b)}',
        'slice': 'function slice(a,s,e){return a.slice(s,e+1)}',
        'shift': 'function shift(a){return a.shift()}',
        'sort': 'function sort(a){return a.toSorted()}',
        'split': 'function split(sep,a,lim){if(arguments.length<3)return a.split(new RegExp(sep));let r=[];while(--lim){let m=a.match(sep);r.push(a.slice(0,m.index));a=a.slice(m.index+m[0].length)}r.push(a);return r}',
        'subst': 'function subst(a,p,s){return a.replace(new RegExp(p,"g"),s)}',
        'unshift': 'function unshift(a,e){a.unshift(e)}',
        'writeln': 'function writeln(..._){console.log(_.join(""))}'
    },
    'php': {
        'push': 'function push(&$a,$x){$a[]=$x;}',
        'len': 'function len($a){return count($a);}',
        'int': 'function int($x){return floor($x);}',
        'sort': ['function ipsort($a){$res=$a;sort($res);return $res;}', 'ipsort'],
        'keys': ['', 'array_keys'],
        'writeln': 'function writeln(...$args){echo implode("", $args)."\n";}'
    },
    'py': {
        'push': 'def push(a,x): a.append(x)',
        'sort': ['', 'sorted'],
        'keys': 'def keys(a): return a.keys()',
        'writeln': 'def writeln(*args): print(*args, sep="")',
        'atan2': 'def atan2(a,b): return math.atan2(a,b)'
    }
};

fn funclib(lang) {
    ret flib{lang};
}
