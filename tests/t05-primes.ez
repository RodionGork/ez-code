# we lack array length and loop break yet, but work-around this

def $target = 20;

def $primes = [2, 3, 5, 7];

def is_prime($x) {
    def $i = 0;
    while (1) {
        def $d = $primes[$i];
        if ($d*$d > $x) ret 1;
        if ($x % $d == 0) ret 0;
        $i += 1;
    }
}

def $n = 9;
def $c = 4;
while (1) {
    if (is_prime($n)) {
        $primes[$c] = $n;
        $c += 1;
        if ($c == $target) {
            writeln("primes[" . $target . "] = " . $primes[$target-1]);
            break;
        }
    }
    $n += 2;
}
