# practical problem - calculates number of steps in collatz conjecture
# sequence A006577 in the OEIS

fn collatz(n) {
    def cnt = 0;
    while (n > 1) {
        if (n % 2) {
            n = n * 3 + 1;
            cnt += 1;
            cont;
        }
        n /= 2;
        cnt += 1;
    }
    ret cnt;
}

def i = 1;
while (i <= 20) {
    writeln(i, " -> ", collatz(i));
    i += 1;
}