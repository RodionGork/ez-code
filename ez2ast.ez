def kws = {
    "def": "p_def",
    "fn": "p_defn",
    "while": "p_cond",
    "if": "p_cond",
    "else": "p_cond",
    "elsif": "p_cond",
    "ret": "p_ret",
    "break": "p_onekw",
    "cont": "p_onekw"
};

def data;
def cur = 0;
def pos = [1, 1];

fn adv() {
    def c = data[cur];
    cur += 1;
    if (!eq(c, "\n")) {
        pos[1] += 1;
    } else {
        pos[0] += 1;
        pos[1] = 1;
    }
    ret c;
}

fn peek() {
    ret data[cur];
}

fn err(msg) {
    halt(1, msg . " at " . join(":", pos));
}

fn fetch_cmp_op() {
    def op = adv();
    if (match(op, '[\<\>]')) {
        if (eq(peek(), "="))
            op .= adv();
        ret op;
    }
    if (!eq(adv(), "="))
        err("unknown comparison operator");
    ret op . "=";
}

fn fetch_log_op() {
    def op = adv();
    if (!eq(adv(), op))
        err("unknown logic operator");
    ret op . op;
}

fn p_array() {
    adv();
    p_space();
    def res = ["array"];
    if (!eq(peek(), "]")) {
        while (1) {
            push(res, p_expr());
            p_space();
            def rbr = adv();
            if (eq(rbr, "]"))
                break;
            if (!eq(rbr, ","))
                err("expected ']' or ',' in array literal");
            p_space();
        }
    } else {
        adv();
    }
    ret res;
}

fn p_asgn(target) {
    p_space();
    def op = adv();
    if (!eq(op, "=")) {
        if (!match(op, '[\+\-\*\/%\.]') || !eq(adv(), "="))
            err("expected '=' in assignment");
        $op .= "=";
    } 
    p_space();
    ret ["asgn", target, op, p_expr()];
}

fn p_assoc() {
    adv();
    p_space();
    def res = ["hash"];
    if (!eq(peek(), "}")) {
        while (1) {
            if (!eq(peek(), '"') && !eq(peek(), "'"))
                err("expected string for key in hash literal");
            push(res, p_str());
            p_space();
            if (!eq(adv(), ":"))
                err("expected ':' after key in hash literal");
            p_space();
            push(res, p_expr());
            p_space();
            def rbr = adv();
            if (eq(rbr, "}"))
                break;
            if (!eq(rbr, ","))
                err("expected '}' or ',' in hash literal");
            p_space();
        }
    } else {
        adv();
    }
    ret res;
}

fn p_block(res) {
    adv(); # opening '{'
    push(res, stlist());
    push(res, "blk");
    p_space();
    if (!eq(adv(), "}"))
        err("expected '}' to end block");
}

fn p_call(fname) {
    p_space();
    if (!eq(adv(), "("))
        err("expected '(' for function call");
    def args = [];
    p_space();
    if (!eq(peek(), ")")) {
        while (1) {
            push(args, p_expr());
            p_space();
            def rbr = adv();
            if (eq(rbr, ")"))
                break;
            if (!eq(rbr, ","))
                err("expected ')' or ',' in argument list");
            p_space();
        }
    } else {
        adv();
    }
    ret ["call", fname, args];
}

fn p_cond(kw, prev) {
    def res = [kw];
    if (match(kw, "else|elsif") && (len(prev) == 0 || !match(prev[len(prev)-1][0], "if|elsif")))
        err(kw . " without preceding if") ;
    p_space();
    if (!eq(kw, "else")) {
        if (!eq(adv(), "("))
            err("expected '(' before condition");
        p_space();
        push(res, p_expr());
        p_space();
        if (!eq(adv(), ")"))
            err("expected ')' after condition");
        p_space();
    }
    if (eq(peek(), "{")) {
        p_block(res);
    } else {
        push(res, [stmt()]);
    }
    ret res;
}

fn p_def() {
    p_space();
    def var = p_var(p_word());
    p_space();
    if (eq(peek(), "="))
        var = p_asgn(var);
    ret ["def", var];
}

fn p_defn() {
    p_space();
    def name = p_word();
    p_space();
    if (!eq(peek(), "("))
        err("expected '(' in function definition");
    adv();
    p_space();
    def args = [];
    p_space();
    if (!eq(peek(), ")")) {
        while (1) {
            push(args, p_var(p_word()));
            p_space();
            def rbr = adv();
            if (eq(rbr, ")"))
                break;
            if (!eq(rbr, ","))
                err("expected ')' or ',' in func arguments");
            p_space();
        }
    } else {
        adv();
    }
    p_space();
    if (!eq(adv(), "{"))
        err("expected '{' to start func body");
    def res = ["defn", name, args];
    p_block(res);
    ret res;
}

fn p_expr() {
    ret p_ex_or();
}

fn p_ex_and() {
    ret p_ex_bop("p_ex_cmp", "&", "fetch_log_op");
}

fn p_ex_bop(fnext, expr, fgetop) {
    def res = [callname(fnext, [])];
    p_space();
    while (match(peek(), expr)) {
        unshift(res, ["op", callname(fgetop, [])]);
        p_space();
        push(res, callname(fnext, []));
        p_space();
    }
    if (len(res) == 1)
        ret res[0];
    ret res;
}

fn p_ex_cmp() {
    ret p_ex_bop("p_ex_sum", '[\<\>\!=]', "fetch_cmp_op");
}

fn p_ex_mul() {
    ret p_ex_bop("p_value", '[\*\/%]', "adv");
}

fn p_ex_or() {
    ret p_ex_bop("p_ex_and", '\|', "fetch_log_op");
}

fn p_ex_sum() {
    ret p_ex_bop("p_ex_mul", '[\+\-\.]', "adv");
}

fn p_onekw(w) {
    ret ["kw1", w];
}

fn p_num() {
    def n = "";
    while (match(peek(), '\d'))
        n .= adv();
    ret ["num", n];
}

fn p_ret() {
    def res = ["ret"];
    p_space();
    if (!eq(peek(), ";"))
    	push(res, p_expr());
    ret res;
}

fn p_space() {
    while (match(peek(), '[\s#]')) {
        if (eq(adv(), "#")) {
            while (!eq(peek(), "\n") && !eq(peek(), "\0"))
                adv();
        }
    }
}

fn p_str() {
    def quote = adv();
    def res = "";
    def esc = 0;
    def start = join(":", pos);
    while (1) {
        def c = adv();
        if (eq(c, "\0"))
            err("unterminated string literal starting at " . start);
        if (!esc) {
            if (eq(c, quote))
                break;
            if (eq(c, "\\"))
                esc = 1;
        } else {
            esc = 0;
        }
        res .= c;
    }
    ret ["str", res, quote];
}

fn p_unary() {
    def op = adv();
    ret ["uop", op, p_value()];
}

fn p_value() {
    if (match(peek(), '[A-Za-z\$]')) {
        def name = p_word();
        p_space();
        if (!eq(peek(), "("))
            ret p_var_indexed(name);
        else
            ret p_call(name);
    }
    if (match(peek(), '[\!\-]'))
        ret p_unary();
    if (match(peek(), '\d'))
        ret p_num();
    if (eq(peek(), '"') || eq(peek(), "'"))
        ret p_str();
    if (eq(peek(), "["))
        ret p_array();
    if (eq(peek(), "{"))
        ret p_assoc();
    if (eq(adv(), "(")) {
        def ex = p_expr();
        p_space();
        if (!eq(adv(), ")"))
            err("expected ')' to end subexpression");
        ret ["brex", ex];
    }
    err("value expected in expression");
}

fn p_var(name) {
    ret ["var", subst(name, '^\$', "")];
}

fn p_var_indexed(name) {
    def var = p_var(name);
    while (match(peek(), '[\[\{]')) {
        def quote = adv();
        p_space();
        push(var, [quote, p_expr()]);
        p_space();
        quote = chr(ord(quote)+2);
        if (!eq(adv(), quote))
            err("expected '. quote . ' after index expression");
    }
    ret var;
}

fn p_word() {
    def w = adv(); # may include dollar sign
    while (match(peek(), '\w'))
        w .= adv();
    ret w;
}

fn stmt(prev) {
    p_space();
    if (!match(peek(), '[A-Za-z\$]'))
        err('letter or \'$\' expected at start of statement');
    def word = p_word();
    if (haskey(word, kws)) {
        ret callname(kws{word}, [word, prev]);
    }
    p_space();
    if (eq(peek(), "("))
        ret p_call(word);
    else
        ret p_asgn(p_var_indexed(word));
}

fn stlist() {
    def res = [];
    while (1==1) {
        p_space();
        if (eq(peek(), "\0") || eq(peek(), "}"))
            break;
        def st = stmt(res);
        push(res, st);
        p_space();
        if (!eq(st[len(st)-1], "blk") && !eq(adv(), ";")) {
            err("expected ';' at the end of statement");
        }
    }
    ret res;
}

fn to_ast(code) {
    data = split("", code);
    push(data, "\0");
    def ast = stlist();
    if (!eq(peek(), "\0"))
    	err("statement expected");
    ret ast;
}

